// QueuePass data model — see specs/002-admin-venues-events/data-model.md
//
// NOTE: The scheduling rule (event_no_overlap), the btree_gist extension, and all CHECK
// constraints live in hand-written migration SQL. Prisma's schema language cannot express
// EXCLUDE constraints. Never run `prisma db push` on this project — it bypasses migration
// SQL and would silently drop the feature's central invariant.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  address         String
  // Spec 013 FR-001, FR-020: the address as four parts, all set or all NULL (NULL for a venue
  // from before 013), and whether the address service matched them. CHECKs in the migration.
  street          String?  @db.VarChar(200)
  city            String?  @db.VarChar(100)
  state           String?  @db.VarChar(2)
  zip             String?  @db.VarChar(5)
  addressVerified Boolean  @default(false)
  seatingCapacity Int
  events          Event[]
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @db.Timestamptz(6)
  // Spec 007: the venue's seating layout.
  sections Section[]
}

model Event {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  location            Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  locationId          String   @db.Uuid
  startsAt            DateTime @db.Timestamptz(6)
  endsAt              DateTime @db.Timestamptz(6)
  totalTicketCapacity Int
  // Spec 016 FR-001: the most valid tickets one customer may hold; NULL is no limit. The range
  // (1 to totalTicketCapacity) is the event_max_tickets_per_customer_range CHECK (migration SQL).
  maxTicketsPerCustomer Int?
  basePrice           Decimal  @db.Decimal(10, 2)
  // Spec 005. A cancelled event is read-only and no longer blocks its venue's time: the
  // event_no_overlap constraint applies only WHERE status = 'SCHEDULED' (migration SQL).
  status              EventStatus @default(SCHEDULED)
  cancelledAt         DateTime?   @db.Timestamptz(6)
  tiers               TicketTier[]
  orders              Order[]
  tickets             Ticket[]
  createdAt           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @db.Timestamptz(6)
  // Spec 007 FR-002: whether customers choose seats.
  reservedSeating     Boolean       @default(false)
  sectionTiers        SectionTier[]

  @@index([locationId])
}

enum EventStatus {
  SCHEDULED
  CANCELLED
}

// Spec 004. Case-insensitive unique names and the CHECK constraints live in the migration SQL.
// The rule "tier quantities never exceed the event's totalTicketCapacity" is enforced by the
// Backend under an event-row lock (specs/004-admin-tiers-search/research.md R2).
model TicketTier {
  id        String   @id @default(uuid()) @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String   @db.Uuid
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  orders    Order[]
  tickets   Ticket[]
  sections  SectionTier[]
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([eventId])
}

// Spec 005. "Never sell more than a tier or the event holds" is enforced by the Backend under
// the event-row lock (specs/005-admin-orders-reporting/research.md R2). Every foreign key is
// RESTRICT: sold tickets keep their event and tier on record.
model Order {
  id               String      @id @default(uuid()) @db.Uuid
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventId          String      @db.Uuid
  tier             TicketTier? @relation(fields: [tierId], references: [id], onDelete: Restrict)
  tierId           String?     @db.Uuid
  customerSub      String
  customerUsername String
  quantity         Int
  unitPrice        Decimal     @db.Decimal(10, 2)
  totalPrice       Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(CONFIRMED)
  tickets          Ticket[]
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  refundedAt       DateTime?   @db.Timestamptz(6)
  // Spec 006 FR-005: the client's id for one confirmation, so a repeat returns this order.
  requestId        String?     @db.Uuid

  @@unique([customerSub, requestId])
  @@index([eventId])
  @@index([tierId])
  @@index([customerSub, createdAt])
}

enum OrderStatus {
  CONFIRMED
  REFUNDED
}

model Ticket {
  id          String       @id @default(uuid()) @db.Uuid
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId     String       @db.Uuid
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Restrict)
  eventId     String       @db.Uuid
  tier        TicketTier?  @relation(fields: [tierId], references: [id], onDelete: Restrict)
  tierId      String?      @db.Uuid
  code        String       @unique
  status      TicketStatus @default(VALID)
  checkedInAt DateTime?    @db.Timestamptz(6)
  // Spec 007: the seat's label when sold; all three set or all null (research R1). One valid
  // ticket per seat is the partial unique index ticket_one_valid_per_seat in the migration.
  seatSection String?
  seatRow     Int?
  seatNumber  Int?

  @@index([orderId])
  @@index([eventId, status])
  @@index([tierId])
}

enum TicketStatus {
  VALID
  VOID
}

// Spec 007: a venue's layout is its sections (research R1). Names are unique per venue ignoring
// case by the expression index section_name_unique_per_venue in the migration.
model Section {
  id          String        @id @default(uuid()) @db.Uuid
  location    Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId  String        @db.Uuid
  name        String
  rows        Int
  seatsPerRow Int
  position    Int
  tiers       SectionTier[]
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(6)

  @@unique([locationId, position])
  @@index([locationId])
}

// Spec 007 FR-004: for one seated event, which tier a section belongs to.
model SectionTier {
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String     @db.Uuid
  section   Section    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sectionId String     @db.Uuid
  tier      TicketTier @relation(fields: [tierId], references: [id], onDelete: Cascade)
  tierId    String     @db.Uuid

  @@id([eventId, sectionId])
  @@index([tierId])
}
