# Copy to .env for local development. Never commit a real .env.

# --- Database ---
POSTGRES_USER=queuepass
POSTGRES_PASSWORD=queuepass
POSTGRES_DB=queuepass
DATABASE_URL=postgresql://queuepass:queuepass@localhost:5432/queuepass?schema=public

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Spec 028: one realm per app (queuepass-admin-app, queuepass-customer-app,
# queuepass-booth-app), made by the seed from its own table; there is no realm setting.

# Shared password for all seeded test users.
# LOCAL DEVELOPMENT ONLY — must never be used in a shared, staging, or production
# environment, and must never be reused as a default for real accounts.
SEED_USER_PASSWORD=test123

# --- Admin web app ---
VITE_API_BASE_URL=http://localhost:3000

# --- Sign-in (OIDC) ---
# Spec 028: each app signs in through its own Keycloak realm. Tokens are issued through the
# browser's Keycloak address (localhost:8080), so a realm's issuer, which the Backend checks, is
# OIDC_ISSUER_BASE/<realm>; its keys are fetched over the Compose network from
# OIDC_JWKS_BASE/<realm>/protocol/openid-connect/certs (spec 001 research R4). The Backend
# accepts the three app realms only.
OIDC_ISSUER_BASE=http://localhost:8080/realms
OIDC_JWKS_BASE=http://keycloak:8080/realms
OIDC_AUDIENCE=queuepass-api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Each app's own realm (built into the app's image as its VITE_OIDC_AUTHORITY).
VITE_ADMIN_OIDC_AUTHORITY=http://localhost:8080/realms/queuepass-admin-app
VITE_CUSTOMER_OIDC_AUTHORITY=http://localhost:8080/realms/queuepass-customer-app
VITE_BOOTH_OIDC_AUTHORITY=http://localhost:8080/realms/queuepass-booth-app

# --- Address service (spec 013) ---
# The US Census Geocoder checks venue addresses. Not a secret: it needs no key. Saving a new
# venue address needs internet; everything else works offline.
ADDRESS_GEOCODER_URL=https://geocoding.geo.census.gov
# Spec 013 research R16 (#25): when the Census Geocoder vouches for no match, OpenStreetMap's
# Nominatim is searched by the street and then by the venue's name. Not a secret: no key, at most
# one request a second. `off` turns it off; empty means the public service.
ADDRESS_MAP_URL=https://nominatim.openstreetmap.org

# --- Purchase rate limits (spec 026) ---
# How many buy attempts, and separately seat-hold attempts, each customer account may make in any
# 60 seconds and in any 5 seconds. Whole numbers of at least 1; the 5-second number may not be
# larger than the minute's. A demo may raise them; nothing switches them off.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_5_SECONDS=3
# Spec 033: seat holds have their own pair, since the Customer app holds each seat as it is clicked.
RATE_LIMIT_HOLD_PER_MINUTE=30
RATE_LIMIT_HOLD_PER_5_SECONDS=10
