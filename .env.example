# Copy to .env for local development. Never commit a real .env.

# --- Database ---
POSTGRES_USER=queuepass
POSTGRES_PASSWORD=queuepass
POSTGRES_DB=queuepass
DATABASE_URL=postgresql://queuepass:queuepass@localhost:5432/queuepass?schema=public

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=queuepass

# Shared password for all seeded test users.
# LOCAL DEVELOPMENT ONLY — must never be used in a shared, staging, or production
# environment, and must never be reused as a default for real accounts.
SEED_USER_PASSWORD=test123

# --- Admin web app ---
VITE_API_BASE_URL=http://localhost:3000

# --- Sign-in (OIDC) ---
# Tokens are issued through the browser's Keycloak address (localhost:8080), so that is the
# issuer the Backend checks. Keys are fetched over the Compose network (research R4).
OIDC_ISSUER=http://localhost:8080/realms/queuepass
OIDC_JWKS_URL=http://keycloak:8080/realms/queuepass/protocol/openid-connect/certs
OIDC_AUDIENCE=queuepass-api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/queuepass

# --- Address service (spec 013) ---
# The US Census Geocoder checks venue addresses. Not a secret: it needs no key. Saving a new
# venue address needs internet; everything else works offline.
ADDRESS_GEOCODER_URL=https://geocoding.geo.census.gov
